      def add_custom_property: (Symbol | String key, untyped value) -> untyped
      def create!: () -> String?

      def rename!: (*untyped) -> bot
      def reload!: () -> bot
    end

    class ContactsCollection < Base::AccountSearchObjectsCollection[Contact]
    end

    class Appointment < Base::Object
      include Utils::BelongsToFolder
      include Utils::BelongsToTag
      include SoapRequest::RequestMethodsMailbox
      include MailboxItemConcern

      attr_accessor uid: String?
      attr_accessor desc: String?
      attr_accessor start_at: Time?
      attr_accessor dur: Integer?
      attr_accessor end_at: Time?
      attr_accessor tn: String?
      attr_accessor allDay: bool
      attr_accessor organizer: Appointment::Organizer?
      attr_accessor timezone: String
      attr_accessor calItemId: String?
      attr_accessor apptId: String?
      attr_accessor invId: String?
      attr_accessor rev: Integer?
      attr_accessor fb: String?
      attr_accessor transp: String?
      attr_accessor recur: untyped
      attr_accessor s: Integer?
      attr_accessor ms: Integer?
      attr_accessor f: String?
      attr_reader recipients: Recipients
      attr_reader attendees: Appointment::Attendees
      attr_reader body: Appointment::BodyMail
      alias description desc
      alias recurrent recur
      alias size s

      def flags: () -> Array[String]
      def download: (String dest_file_path, ?fmt: String) -> nil
      def read: () -> String
      def create!: () -> String?
      def reload!: () -> untyped

      # Set the free/busy status locally, call modify! to save it.
      def free!: () -> String
      def busy!: () -> String
      def must_confirm!: () -> String
      def out_of_office!: () -> String

      def update!: (*untyped) -> bot
      def rename!: (*untyped) -> bot

      class Organizer
        attr_accessor email: String
        attr_accessor display_name: String?

        def initialize: (String email, ?String? display_name) -> void
      end

      class Attendee
        attr_accessor email: String
        attr_accessor display_name: String?
        attr_accessor role: String
        attr_accessor ptst: String
        attr_accessor rsvp: Integer | bool

        def initialize: (String email, ?String? display_name, ?String role, ?String ptst, ?Integer | bool rsvp)
                      -> void
      end

      class Attendees
        def initialize: () -> void

        def map: [U] () { (Attendee) -> U } -> Array[U]
        def add: (untyped attendee) -> Array[Attendee]?
        def del: (Attendee | String attendee) -> untyped
        def clear: () -> Array[Attendee]
      end

      class BodyMail
        attr_accessor text: String?
        attr_accessor html: String?
      end
    end

    class Recipients
      def initialize: () -> void

      def map: [U] () { (Recipient) -> U } -> Array[U]
      def add: (untyped recipient) -> Array[Recipient]?
      def del: (Recipient | String recipient) -> untyped
      def clear: () -> Array[Recipient]
      def to: () -> Array[Recipient]
      def cc: () -> Array[Recipient]
      def bcc: () -> Array[Recipient]
      def from: () -> Array[Recipient]
    end

    class AppointmentsCollection < Base::AccountSearchObjectsCollection[Appointment]
      # Searches year by year, from 10 years ago to 10 years ahead by default.
      def find_each: (?offset: Integer, ?limit: Integer, ?start_year: Integer?, ?end_year: Integer?)
                       { (Appointment) -> void } -> void
    end

    class Task < Base::Object
      include Utils::BelongsToFolder
      include Utils::BelongsToTag

      def download: (String dest_file_path, ?fmt: String) -> nil

      def create!: () -> bot
      def modify!: () -> bot
      def update!: (*untyped) -> bot
      def rename!: (*untyped) -> bot
      def reload!: () -> bot
      def delete!: () -> bot
    end

    class TasksCollection < Base::AccountSearchObjectsCollection[Task]
      def find_each: (?offset: Integer, ?limit: Integer) { (Task) -> void } -> void
    end

    class Document < Base::Object
      include Utils::BelongsToFolder
      include Utils::BelongsToTag
      include SoapRequest::RequestMethodsMailbox

      def download: (String dest_file_path) -> nil

      def create!: () -> bot
      def modify!: () -> bot
      def update!: (*untyped) -> bot
      def rename!: (*untyped) -> bot
      def reload!: () -> bot
    end

    class DocumentsCollection < Base::AccountSearchObjectsCollection[Document]
      def find_each: (?offset: Integer, ?limit: Integer) { (Document) -> void } -> void
    end

