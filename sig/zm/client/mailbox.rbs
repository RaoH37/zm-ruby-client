    class DataSource < Base::Object
      include SoapRequest::RequestMethodsMailbox

      def initialize: (untyped parent, String data_source_type) -> void

      def create!: () -> bot
      def modify!: () -> bot
      def rename!: (*untyped) -> bot
    end

    class DataSourcesCollection < Base::AccountObjectsCollection[DataSource]
    end

    class Ace < Base::Object
      GT_USER: String
      GT_GROUP: String
      GT_DOMAIN: String
      GT_PUB: String
      GT_KEY: String

      attr_accessor zid: String?
      attr_accessor gt: String?
      attr_accessor right: String?
      attr_accessor d: String?
    end

    class AcesCollection < Base::AccountObjectsCollection[Ace]
      attr_reader rights: Array[String]

      def new_from_object: (Account | Resource | DistributionList | Domain item, String right) -> Ace
      def create_from_object: (Account | Resource | DistributionList | Domain item, String right) -> Ace
      def add: (Ace ace) -> Array[Ace]
      def where: (*(String | Array[String]) rights) -> self
    end

    class Share < Base::Object
      attr_accessor ownerId: String?
      attr_accessor ownerEmail: String?
      attr_accessor ownerName: String?
      attr_accessor folderId: String?
      attr_accessor folderUuid: String?
      attr_accessor folderPath: String?
      attr_accessor view: String?
      attr_accessor rights: String?
      attr_accessor granteeType: String?
      attr_accessor granteeId: String?
      attr_accessor granteeName: String?
      attr_accessor mid: String?

      def mountpoints: () -> ShareMountPointsCollection
    end

    class ShareMountPointsCollection
      def initialize: (Share share) -> void

      def new: () -> MountPoint
      def all: () -> Array[MountPoint]
      alias all! all
    end

    class SharesCollection < Base::ObjectsCollection[Share]
      def where: (?owner_name: String?) -> self
    end

    class FilterRule < Base::Object
      attr_accessor active: bool?
      attr_accessor filterTests: untyped
      attr_accessor filterActions: untyped
    end

    class FilterRulesCollection < Base::AccountObjectsCollection[FilterRule]
    end

    class OutgoingFilterRulesCollection < FilterRulesCollection
    end

    class AccountDlsMembershipCollection < Base::ObjectsCollection[DistributionList]
    end

    class AccountDlsOwnerCollection < Base::ObjectsCollection[DistributionList]
    end

    module Base
      class MailboxPrefsCollection
        def initialize: (MailboxObject parent) -> void

        def all: () -> Hash[Symbol, untyped]?
        alias all! all
        def clear: () -> void
        def preferences: (*(String | Array[String]) entries) -> self
        def update!: (Hash[Symbol | String, untyped] hash) -> untyped
      end

      class MailboxInfosCollection
        def initialize: (MailboxObject parent) -> void

        def all: () -> Hash[Symbol, untyped]
        alias all! all
        def clear: () -> void
        def sections: (*(String | Array[String]) entries) -> self
        def rights: (*(String | Array[String]) entries) -> self
        # Reads the mbox section and fills id, used, public_url, zimbraCOSId and home_url on the mailbox.
        def read: () -> Hash[Symbol, untyped]
        def zimbraMailHost: () -> String?
        def zimbraMailHost!: () -> String?
      end
    end
  end
end
