      attr_accessor homePhone: String?
      attr_accessor homePostalCode: String?
      attr_accessor homeState: String?
      attr_accessor homeStreet: String?
      attr_accessor homeURL: String?
      attr_accessor imAddress1: String?
      attr_accessor imAddress2: String?
      attr_accessor imAddress3: String?
      attr_accessor imAddress4: String?
      attr_accessor imAddress5: String?
      attr_accessor jobTitle: String?
