      attr_accessor otherPhone: String?
      attr_accessor otherPostalCode: String?
      attr_accessor otherState: String?
      attr_accessor otherStreet: String?
      attr_accessor otherURL: String?
      attr_accessor pager: String?
      attr_accessor workCity: String?
      attr_accessor workCountry: String?
      attr_accessor workFax: String?
      attr_accessor workPhone: String?
      attr_accessor workPostalCode: String?
      attr_accessor workState: String?
      attr_accessor workStreet: String?
      attr_accessor workURL: String?
      attr_accessor image: String?
