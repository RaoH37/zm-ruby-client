      def create!: () -> String?
    end

    class TagsCollection < Base::AccountObjectsCollection[Tag]
    end

    class Identity < Base::Object
      include SoapRequest::RequestMethodsMailbox

      def create!: () -> String?
      def rename!: (*untyped) -> bot
