      attr_accessor maidenName: String?
      attr_accessor middleName: String?
      attr_accessor mobilePhone: String?
      attr_accessor namePrefix: String?
      attr_accessor nameSuffix: String?
      attr_accessor nickname: String?
      attr_accessor notes: String?
