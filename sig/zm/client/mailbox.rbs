    end

    class Signature < Base::Object
      include SoapRequest::RequestMethodsMailbox

      attr_accessor txt: String?
      attr_accessor html: String?

      def create!: () -> String
      def type: () -> String
      def html?: () -> bool
      def txt?: () -> bool
