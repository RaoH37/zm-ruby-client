module Zm
  module SoapRequest
    class SoapElement
    end

    module RequestMethodsAdmin
      def delete!: () -> nil
      def modify!: (?force: bool) -> bool
      def update!: (?Hash[Symbol, untyped]? hash, ?update_attributes: bool, ?force: bool, **untyped attrs) -> bool
      def rename!: (String new_name) -> String

      def build_create: () -> SoapElement
      def build_modify: (?force: bool) -> SoapElement
      def build_delete: () -> SoapElement
      def build_rename: (String new_name) -> SoapElement
    end
  end

  module Client
    class Account < Base::MailboxObject
      extend Base::HasZimbraAttributes
      include Base::HasZimbraAttributes::InstanceMethods

      include SoapRequest::RequestMethodsAdmin

      def cos: () -> Cos?
      def create!: () -> String
      def created_at: () -> Time?
      def flush_cache!: () -> true
      def batch: () -> BatchRequest
      def empty_dumpster!: () -> untyped
    end

    class AccountsCollection < Base::AdminObjectsCollection[Account]
      def all: () -> AccountsResponse
      alias all! all
      def find_in_batches: (?offset: Integer, ?limit: Integer) { (AccountsResponse) -> void } -> nil
      def quotas: (?domain_name: String?, ?target_server_id: String?) -> Array[untyped]?
    end

    # Accounts returned by AccountsCollection#all and find_in_batches.
    # by_server and statuses read zimbraMailHost and zimbraAccountStatus: an account searched without them
    # (attrs) is counted under nil.
    class AccountsResponse < Base::AdminObjectsResponse[Account]
      def by_server: () -> Hash[String?, AccountsResponse]
      def statuses: () -> Hash[String?, Integer]
    end

    class AccountAliasesCollection
      def initialize: (Account parent) -> void

      def all: () -> Array[String]
      def add!: (String email) -> bool
      def remove!: (String email) -> bool
    end

    class Resource < Base::MailboxObject
      extend Base::HasZimbraAttributes
      include Base::HasZimbraAttributes::InstanceMethods

      include SoapRequest::RequestMethodsAdmin

      LOCATION: String
      EQUIPMENT: String
      TYPES: Array[String]

      def create!: () -> String
      def location?: () -> bool
      def equipment?: () -> bool
    end

    class ResourcesCollection < Base::AdminObjectsCollection[Resource]
      def all: () -> ResourcesResponse
      alias all! all
      def find_in_batches: (?offset: Integer, ?limit: Integer) { (ResourcesResponse) -> void } -> nil
    end

    # Resources returned by ResourcesCollection#all and find_in_batches.
    # locations and equipments read zimbraCalResType: a resource searched without it (attrs) is in neither.
    class ResourcesResponse < Base::AdminObjectsResponse[Resource]
      def locations: () -> ResourcesResponse
      def equipments: () -> ResourcesResponse
    end

    class Domain < Base::Object
      extend Base::HasZimbraAttributes
      include Base::HasZimbraAttributes::InstanceMethods

      include SoapRequest::RequestMethodsAdmin

      LOCAL: String
      ALIAS: String

      def create!: () -> String
      def cos: () -> Cos?
      def DKIMPublicTxt: () -> String?

      def accounts: () -> DomainAccountsCollection
      def resources: () -> DomainResourcesCollection
      def distribution_lists: () -> DomainDistributionListsCollection
      alias distributionlists distribution_lists
    end

    class DomainsCollection < Base::AdminObjectsCollection[Domain]
      def all: () -> DomainsResponse
      alias all! all
      def find_in_batches: (?offset: Integer, ?limit: Integer) { (DomainsResponse) -> void } -> nil
    end

    # Domains returned by DomainsCollection#all and find_in_batches.
    # locals and aliases read zimbraDomainType, statuses zimbraDomainStatus: a domain searched without them (attrs)
    # is in neither group and counted under nil.
    class DomainsResponse < Base::AdminObjectsResponse[Domain]
      def locals: () -> DomainsResponse
      def aliases: () -> DomainsResponse
      def statuses: () -> Hash[String?, Integer]
    end

    class DomainAccountsCollection < AccountsCollection
    end

    class DomainResourcesCollection < ResourcesCollection
    end

    class DomainDistributionListsCollection < DistributionListsCollection
    end

    class Cos < Base::Object
      extend Base::HasZimbraAttributes
      include Base::HasZimbraAttributes::InstanceMethods

      def create!: () -> String
      def modify!: (?force: bool) -> bool
      def update!: (?Hash[Symbol, untyped]? hash, ?update_attributes: bool, ?force: bool, **untyped attrs) -> bool
      def delete!: () -> nil
      def clone!: (String new_name) -> String

      def servers: () -> CosServersCollection
      def domains: () -> CosDomainsCollection
      def accounts: () -> CosAccountsCollection
    end

    class CosServersCollection
      def initialize: (Cos parent) -> void

      def all: () -> Array[Server]
      alias all! all
      def add!: (*(Server | Array[Server]) servers) -> bool
      def remove!: (*(Server | Array[Server]) servers) -> bool
    end

    class CosDomainsCollection < DomainsCollection
    end

    class CosAccountsCollection < AccountsCollection
    end

    class CosesCollection < Base::AdminObjectsCollection[Cos]
      def clone!: (String new_name) ?{ (Cos) -> void } -> String
    end

    class Server < Base::Object
      extend Base::HasZimbraAttributes
      include Base::HasZimbraAttributes::InstanceMethods

      def update!: (?Hash[Symbol, untyped]? hash, ?update_attributes: bool, ?force: bool, **untyped attrs) -> bool
      def mailboxes: () -> Array[Hash[Symbol, untyped]]?

      def mta_queues: () -> MtaQueuesCollection
      def backups: () -> BackupsCollection
      def accounts: () -> ServerAccountsCollection
    end

    class MtaQueue < Base::Object
      attr_accessor n: Integer?
      alias nb_items n

      def server: () -> Server
      def hold!: (Array[String] ids) -> untyped
      def release!: (Array[String] ids) -> untyped
      def delete!: (Array[String] ids) -> untyped
      def requeue!: (Array[String] ids) -> untyped
    end

    class MtaQueuesCollection < Base::ObjectsCollection[MtaQueue]
      # The known queues without querying the server.
      def defaults: () -> Array[MtaQueue]
      def defaults!: () -> Array[MtaQueue]
      # Raises Zm::Error::ZmError on an unknown queue name.
      def find: (String queue_name) -> MtaQueue?
    end

    class Backup < Base::Object
      attr_accessor label: String?
      attr_accessor type: String?
      attr_accessor aborted: bool?
      attr_accessor start: Integer?
      attr_accessor end: Integer?
      attr_accessor minRedoSeq: Integer?
      attr_accessor maxRedoSeq: Integer?
      attr_accessor live: bool?
      attr_accessor accounts: untyped
      alias name label

      def server: () -> Server
      def start_at: () -> Time?
      def end_at: () -> Time?
      def full?: () -> bool
      def incremental?: () -> bool
    end

    class BackupsCollection < Base::ObjectsCollection[Backup]
    end

    class ServerAccountsCollection < AccountsCollection
    end

    class ServersCollection < Base::AdminObjectsCollection[Server]
      # Filters servers by enabled service (mailbox, mta, proxy...).
      def where: (String service) -> self
      def all: () -> ServersResponse
      alias all! all
    end

    # Servers returned by ServersCollection#all, selected by zimbraServiceEnabled (ServerServices).
    class ServersResponse < Base::AdminObjectsResponse[Server]
      def with_service: (String service) -> ServersResponse
      def mailbox_servers: () -> ServersResponse
      def mta_servers: () -> ServersResponse
      def proxy_servers: () -> ServersResponse
      def ldap_servers: () -> ServersResponse
      # A server is in the group of each of its enabled services.
      def by_service: () -> Hash[String, ServersResponse]
    end

    class DistributionList < Base::Object
      extend Base::HasZimbraAttributes
      include Base::HasZimbraAttributes::InstanceMethods

      include SoapRequest::RequestMethodsAdmin

      def create!: () -> String
      def local_transport: () -> String
      def local_transport!: () -> bool
      def local_transport?: () -> bool
      def external_transport?: () -> bool
      def hide_in_gal?: () -> bool
      def group?: () -> bool
      def mailing_list?: () -> bool

      def aliases: () -> DistributionListAliasesCollection
      def members: () -> DistributionListMembersCollection
      def owners: () -> DistributionListOwnersCollection
      def memberships: () -> DlsMembershipCollection
      def aces: () -> DistributionListAcesCollection
    end

    class DistributionListsCollection < Base::AdminObjectsCollection[DistributionList]
      def all: () -> DistributionListsResponse
      alias all! all
      def find_in_batches: (?offset: Integer, ?limit: Integer) { (DistributionListsResponse) -> void } -> nil
    end

    # Distribution lists returned by DistributionListsCollection#all and find_in_batches.
    # groups (zimbraMailStatus disabled) and mailing_lists (enabled): a list searched without zimbraMailStatus
    # (attrs) is in neither.
    class DistributionListsResponse < Base::AdminObjectsResponse[DistributionList]
      def groups: () -> DistributionListsResponse
      def mailing_lists: () -> DistributionListsResponse
    end

    class DistributionListAliasesCollection
      def initialize: (DistributionList parent) -> void

      def all: () -> Array[String]
      def add!: (String email) -> bool
      def remove!: (String email) -> bool
    end

    class DistributionListMembersCollection
      attr_accessor all: Array[String]

      def initialize: (DistributionList parent) -> void

      # Raises ArgumentError on nil, non-String or blank email.
      def add!: (String | Array[String] emails) -> bool
      def remove!: (String | Array[String] emails) -> bool
    end

    class DistributionListOwnersCollection
      attr_accessor all: Array[String]

      def initialize: (DistributionList parent) -> void

      def add!: (*(String | Array[String]) emails) -> bool
      def remove!: (*(String | Array[String]) emails) -> bool
    end

    class DlMembership < Data
      attr_reader name: String
      attr_reader id: String
      attr_reader via: String?
    end

    class DlsMembershipCollection < Base::ObjectsCollection[DlMembership]
    end

    class DistributionListAcesCollection
      class DistributionListAce < Data
        attr_reader zimbra_id: String
        attr_reader type: String
        attr_reader right: String?
      end

      def initialize: (DistributionList parent) -> void

      def all: () -> Array[DistributionListAce]
    end

    class Upload
      def initialize: (String base_url, String token, ?is_token_admin: bool, **untyped rest_options) ?{ (Upload) -> void } -> void

      def download_file: (String dest_file_path, String file_id, String? type, ?fmt: String?) -> nil
      def read_file: (String file_id, String? type, ?fmt: String?) -> String
      def download_files: (String dest_file_path, Array[String] file_ids, String? type, ?fmt: String?) -> nil
      def download_attachment: (String dest_file_path, String message_id, String part) -> nil
      def download_folder: (String dest_file_path, String folder_id, ?fmt: String?) -> nil
      def send_file: (String src_file_path, String folder_id, ?fmt: String?, ?type: String?, ?resolve: String?) -> String
      def upload_attachment: (String src_file_path) -> String
      def download_file_with_url: (String url, String dest_file_path) -> nil
      def same_origin?: (String url) -> bool
    end
  end
end
